{
  "name": "bbs-develop-by-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.129.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "node scripts/ensure-d1.mjs && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:skip-d1": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
  }
}
